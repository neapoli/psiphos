<?php

/**
 * @file
 * Psíphos — svolgimento a distanza delle sedute collegiali deliberative.
 *
 * Attua la nota MIM prot. 3803 del 30/06/2026 e il relativo allegato tecnico
 * «Requisiti tecnico-organizzativi per la gestione digitale degli organi
 * collegiali e delle operazioni di voto nelle istituzioni scolastiche», in
 * applicazione dell'art. 44, commi 3 lett. a) e b) e 6, del CCNL comparto
 * Istruzione e Ricerca del 18/01/2024 (triennio 2019-2021).
 */

declare(strict_types=1);

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\psiphos\Entity\Delibera;
use Drupal\psiphos\Entity\Seduta;
use Drupal\psiphos\Entity\Verbale;
use Drupal\psiphos\Enum\EventoAudit;
use Drupal\psiphos\Enum\StatoDelibera;
use Drupal\psiphos\Enum\StatoPresenza;
use Drupal\psiphos\Enum\StatoSeduta;
use Drupal\psiphos\Enum\StatoVerbale;

/**
 * Implements hook_help().
 */
function psiphos_help(string $route_name, RouteMatchInterface $route_match): string {
  return match ($route_name) {
    'help.page.psiphos' => '<p>' . t('Psíphos gestisce le sedute collegiali deliberative svolte a distanza: convocazione, ordine del giorno, presenze, votazioni palesi e a scrutinio segreto, verbalizzazione.') . '</p>'
      . '<p>' . t('Il modulo non sostituisce la piattaforma di videoconferenza: l\'allegato tecnico consente espressamente l\'integrazione di più strumenti, purché ciascuno sia conforme ai requisiti per la propria funzione. Psíphos copre le operazioni di voto e la documentazione della seduta.') . '</p>'
      . '<p>' . t('Prima dell\'uso in sedute deliberative il Regolamento d\'istituto deve essere integrato ai sensi del §8 dell\'allegato tecnico.') . '</p>',
    'psiphos.settings' => '<p>' . t('Impostazioni di identificazione, autenticazione e sessione previste dal §3 dell\'allegato tecnico.') . '</p>',
    default => '',
  };
}

